# =============================================================================
# Docker Compose Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!
# =============================================================================

# --- Supabase ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Frontend server-side authentication (never use NEXT_PUBLIC_ names) ---
FIREBASE_SERVICE_ACCOUNT_KEY=your-base64-encoded-service-account-json
AUTH_HMAC_SECRET=generate-a-unique-random-secret-of-at-least-32-bytes
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=verify@your-verified-domain.com

# --- Backend API ---
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Automated launch gate ---
# Server-controlled timestamp in ISO 8601 with timezone. Default is 12:00 PM IST on 2026-08-28.
APP_LAUNCH_AT=2026-08-28T12:00:00+05:30

# Optional browser push public key. Permission still requires a user click.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
CRON_SECRET=generate-a-long-random-value

# --- Google Gemini AI ---
# Get from https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key

# --- Razorpay ---
# Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Dashboard → Subscriptions → Plans → Create Plan (one per tier)
RAZORPAY_PLAN_MONTHLY=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_MONTHLY_PRO=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_THREE_MONTH=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_YEARLY=plan_xxxxxxxxxxxx

# --- CORS ---
# Comma-separated list of exact origins allowed to call the backend API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- WebRTC TURN Server (for sparring P2P connections) ---
# Get these from a TURN service like Twilio Network Traversal, Xirsys, or self-hosted coturn
# Required for users behind symmetric NATs / corporate firewalls
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_USERNAME=your-username
TURN_CREDENTIAL=your-password
TURNS_SERVER_URL=turns:your-turn-server.com:5349
TURNS_USERNAME=your-username
TURNS_CREDENTIAL=your-password

# --- Development ---
NEXT_PUBLIC_ENABLE_DEV_SKIP=false