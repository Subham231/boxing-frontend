# --- Supabase (Frontend uses anon key) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Backend API URL ---
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Google Tag Manager ---
NEXT_PUBLIC_GTM_ID=GTM-TWLX8P7R

# --- Server-side authentication (never prefix these with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FIREBASE_SERVICE_ACCOUNT_KEY=your-base64-encoded-service-account-json
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=verify@your-verified-domain.com
AUTH_HMAC_SECRET=generate-a-unique-random-secret-of-at-least-32-bytes

# --- Razorpay ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx (keep in .env.local only)
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret (keep in .env.local only)
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret (keep in .env.local only)

# --- Razorpay Subscription Plan IDs ---
# RAZORPAY_PLAN_MONTHLY=plan_xxxxxxxxxxxx (keep in .env.local only)
# RAZORPAY_PLAN_MONTHLY_PRO=plan_xxxxxxxxxxxx (keep in .env.local only)
# RAZORPAY_PLAN_THREE_MONTH=plan_xxxxxxxxxxxx (keep in .env.local only)
# RAZORPAY_PLAN_YEARLY=plan_xxxxxxxxxxxx (keep in .env.local only)

# --- Polar international payments (server-side only; never NEXT_PUBLIC_*) ---
# POLAR_ACCESS_TOKEN=your-polar-access-token (keep in .env.local only)
# POLAR_WEBHOOK_SECRET=your-polar-webhook-secret (keep in .env.local only)
# POLAR_ORGANIZATION_ID=your-polar-organization-id (keep in .env.local only)
# POLAR_ENVIRONMENT=production

# --- Legacy password-reset OTP delivery (server-side only; never NEXT_PUBLIC_*) ---
# Configure the Resend sender address on a verified domain.

# --- WebRTC TURN Server Configuration (for sparring) ---
# Required for symmetric NAT traversal in P2P connections
# Get these from a TURN service like Twilio, Xirsys, or self-hosted coturn
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-password
# TURNS_SERVER_URL=turns:your-turn-server.com:5349 (TLS variant for strict firewalls)
# TURNS_USERNAME=your-username
# TURNS_CREDENTIAL=your-password

# --- Google Ad Manager / Rewarded Ad placeholders ---
# Replace these once the GAM account and reward callback are configured.
# GAM_REWARD_PROVIDER=google_ad_manager
# GAM_SSV_SECRET=your-gam-ssv-secret
# GAM_NETWORK_CODE=12345678
# GAM_API_KEY=your-gam-api-key
# GAM_REWARDED_AD_UNIT_ID=1234567890
# GAM_CALLBACK_URL=https://your-domain.com/api/spar/ad-reward

# --- Development ---
# NEXT_PUBLIC_ENABLE_DEV_SKIP=false