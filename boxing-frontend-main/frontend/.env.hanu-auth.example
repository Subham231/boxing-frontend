# HanuOTP dark-launch env vars (phase 1)
#
# This project has no existing .env.example, so these are documented here
# instead. Add the real values to wherever you already keep secrets for
# this app (Vercel project settings / local .env). None of these are
# NEXT_PUBLIC_ — they must never reach the browser bundle.
#
# Nothing reads these yet except the new, uncalled /api/hanu-auth/* routes
# — see /hanuotp-integration-plan.md for status.

# The exact HanuOTP endpoint from your account. Code defaults to
# https://api.hanuotp.in/sms-otp.php if this is unset — only set it here if
# you want to point at a different/mock endpoint during testing.
# HANUOTP_BASE_URL=https://api.hanuotp.in/sms-otp.php

# Your HanuOTP API key. Use a ROTATED key — the one shared earlier in chat
# should be treated as compromised and not used here.
HANUOTP_API_KEY=

# Any new random 32+ byte secret, separate from any Firebase secret. Signs
# both the OTP hash (hanu_otp_verifications.otp_hash) and the session hash
# (hanu_auth_sessions.session_hash). Generate one with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_HMAC_SECRET=
